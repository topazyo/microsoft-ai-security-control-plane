# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Logs and temp
*.log
*.tmp
*.bak

# Python (scripts/ holds the refresh-cadence automation)
__pycache__/
*.py[cod]
.pytest_cache/

# Environment/secrets
.env
.env.*

# OMC
.omc/

# Claude Code local settings (personal, machine-specific)
.claude/settings.local.json
.claude/session-logs/

# Claude Code creates isolated worktrees here. Each one is a full checkout of
# this repository, so without this rule they show up as untracked content in
# the parent checkout and can be committed by accident.
.claude/worktrees/

# CLAUDE.md is kept local: it carries absolute vault-import paths that would
# publish a workstation layout and username in a public repository, and would
# not resolve for anyone else cloning. Shared, portable instructions belong in
# .claude/rules/ instead, which is tracked.
/CLAUDE.md
